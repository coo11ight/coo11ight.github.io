---
import { FormattedDate } from 'astro-pure/user'

import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPosts } from '@/lib/posts'

const posts = (await getPosts()).slice(0, 5)
const focus = ['AI workflow', 'Frontend notes', 'Learning review']
---

<BaseLayout meta={{ title: 'COOLAI', description: '写作、技术与 AI 学习记录' }}>
  <main class="mx-auto max-w-5xl">
    <section data-polish="home-hero" class="grid gap-8 py-6 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end">
      <div>
        <p class="coolai-kicker mb-4">COOLAI / Field Notes</p>
        <h1 class="text-4xl font-semibold leading-tight sm:text-5xl">COOLAI</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-muted-foreground">
          写作、技术与 AI 学习记录。这里先从小文章开始，把问题、实验和复盘稳定沉淀下来。
        </p>
        <ul class="mt-7 flex flex-wrap gap-2">
          {focus.map((item) => (
            <li class="coolai-tag">{item}</li>
          ))}
        </ul>
      </div>

      <aside class="coolai-hero-mark p-5">
        <div class="flex items-start justify-between">
          <div>
            <p class="text-sm text-muted-foreground">Current track</p>
            <p class="mt-1 text-2xl font-semibold">AI + Writing</p>
          </div>
          <div class="flex size-12 items-center justify-center rounded-lg border bg-background font-semibold">
            CA
          </div>
        </div>
        <div class="mt-14 grid gap-4">
          <div class="coolai-stat">
            <p class="text-sm text-muted-foreground">Input</p>
            <p class="font-medium">阅读、试验、记录问题</p>
          </div>
          <div class="coolai-stat">
            <p class="text-sm text-muted-foreground">Output</p>
            <p class="font-medium">短文、清单、复盘</p>
          </div>
        </div>
      </aside>
    </section>

    <section class="mt-14">
      <div class="mb-5 flex items-end justify-between gap-4">
        <div>
          <p class="coolai-kicker mb-2">Selected writing</p>
          <h2 class="text-2xl font-semibold">Latest Posts</h2>
        </div>
        <a href="/blog" class="text-sm text-muted-foreground hover:text-primary">View all →</a>
      </div>
      <ul class="grid gap-3">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="coolai-post-card">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="text-lg font-medium">{post.data.title}</h3>
                <span class="text-sm text-muted-foreground">
                  <FormattedDate date={post.data.publishDate} />
                </span>
              </div>
              <p class="mt-3 max-w-2xl text-sm leading-6 text-muted-foreground">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>
